  "info": {
    "_postman_id": "adb4f306-ad1d-448e-83b3-e60db8a8ddda",
    "name": "AWS Glue API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "AWS Glue is a fully managed serverless ETL service. The Glue API uses an\nAWS JSON 1.1 RPC protocol: operations are POST requests to the root path\nwith the operation name specified in the X-Amz-Target header (e.g.\n`AWSGlue.GetDatabases`). All requests are signed with AWS Signature\nVersion 4 (SigV4).\n\nSee https://docs.aws.amazon.com/glue/latest/webapi/WebAPI_Welcome.html\n",
      "type": "text/plain"
    }
  }
